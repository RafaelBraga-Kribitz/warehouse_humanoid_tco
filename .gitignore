# Data — raw and interim are never committed
data/raw/unifolm_wbt/
data/raw/at_wages/
data/interim/
data/processed/*.parquet
data/processed/*.csv
# dbt validation layer — generated database and compiled models
analytics/dbt/target/
analytics/dbt/dbt_packages/
# MANIFEST.yaml files ARE committed
!data/raw/MANIFEST.yaml
!data/processed/MANIFEST.yaml

# Notebooks — .ipynb is generated from .py source via jupytext
notebooks/*.ipynb
!notebooks/01_data_profile_summary.ipynb

# Reports — rendered outputs are not committed; sources (.qmd) are
reports/*.html
!reports/Executive_Summary_DE.html
reports/*.pdf
# Recruiter-facing decision artifacts ARE committed (F-216/F-227/F-228 — README links them)
!reports/Executive_Summary_DE.pdf
!reports/Executive_Summary_EN.pdf
!reports/exhibit_deck.pdf
reports/*.log
reports/*_files/
reports/*.typ
reports/*.quarto_ipynb
# derisk_inspection_report.json IS committed — it pins dataset SHAs for reproducibility

