{
  "name": "warehouse_humanoid_tco",
  "compatibilityLevel": 1550,
  "model": {
    "tables": [
      {
        "name": "Humanoid_Capabilities_Summary",
        "columns": [
          {
            "name": "task_category",
            "dataType": "string",
            "isKey": true,
            "sortByColumn": "n_episodes"
          },
          {
            "name": "n_episodes",
            "dataType": "int64",
            "summarizeBy": "sum"
          },
          {
            "name": "cycle_time_p50",
            "dataType": "double",
            "summarizeBy": "average",
            "displayFolder": "Cycle Time"
          },
          {
            "name": "cycle_time_p95",
            "dataType": "double",
            "summarizeBy": "average",
            "displayFolder": "Cycle Time"
          },
          {
            "name": "cycle_time_mean",
            "dataType": "double",
            "summarizeBy": "average",
            "displayFolder": "Cycle Time"
          },
          {
            "name": "cycle_time_std",
            "dataType": "double",
            "summarizeBy": "average",
            "displayFolder": "Cycle Time"
          },
          {
            "name": "reach_mean_meters",
            "dataType": "double",
            "summarizeBy": "average",
            "displayFolder": "Reach"
          },
          {
            "name": "reach_max_meters",
            "dataType": "double",
            "summarizeBy": "max",
            "displayFolder": "Reach"
          },
          {
            "name": "energy_proxy_mean",
            "dataType": "double",
            "summarizeBy": "average",
            "displayFolder": "Energy"
          },
          {
            "name": "success_rate",
            "dataType": "double",
            "summarizeBy": "average"
          },
          {
            "name": "insufficient_sample",
            "dataType": "boolean"
          }
        ],
        "measures": [
          {
            "name": "Avg_Cycle_Time",
            "expression": "AVERAGE([cycle_time_mean])"
          },
          {
            "name": "Max_Reach",
            "expression": "MAX([reach_max_meters])"
          },
          {
            "name": "Avg_Success_Rate",
            "expression": "AVERAGE([success_rate])"
          }
        ]
      },
      {
        "name": "Simulation_Runs",
        "columns": [
          {
            "name": "scenario_id",
            "dataType": "string",
            "isKey": false
          },
          {
            "name": "run_id",
            "dataType": "int64",
            "isKey": false
          },
          {
            "name": "throughput_orders_per_shift",
            "dataType": "int64",
            "summarizeBy": "average"
          },
          {
            "name": "queue_length_mean",
            "dataType": "double",
            "summarizeBy": "average"
          },
          {
            "name": "seed",
            "dataType": "int64"
          }
        ],
        "measures": [
          {
            "name": "Avg_Throughput",
            "expression": "AVERAGE([throughput_orders_per_shift])"
          },
          {
            "name": "StDev_Throughput",
            "expression": "STDEV.S([throughput_orders_per_shift])"
          },
          {
            "name": "Max_Queue",
            "expression": "MAX([queue_length_mean])"
          }
        ]
      },
      {
        "name": "TCO_Scenarios",
        "columns": [
          {
            "name": "scenario_id",
            "dataType": "string",
            "isKey": true
          },
          {
            "name": "npv_eur",
            "dataType": "int64",
            "summarizeBy": "sum",
            "formatString": "€#,##0"
          },
          {
            "name": "irr",
            "dataType": "double",
            "summarizeBy": "average",
            "formatString": "0.00%"
          },
          {
            "name": "payback_years",
            "dataType": "double",
            "summarizeBy": "average"
          },
          {
            "name": "total_capex_eur",
            "dataType": "int64",
            "summarizeBy": "sum",
            "formatString": "€#,##0",
            "displayFolder": "Costs"
          },
          {
            "name": "total_opex_5yr_eur",
            "dataType": "int64",
            "summarizeBy": "sum",
            "formatString": "€#,##0",
            "displayFolder": "Costs"
          }
        ],
        "measures": [
          {
            "name": "Total_Cost",
            "expression": "[total_capex_eur] + [total_opex_5yr_eur]"
          },
          {
            "name": "Capex_Ratio",
            "expression": "DIVIDE([total_capex_eur], [total_capex_eur] + [total_opex_5yr_eur])"
          },
          {
            "name": "Best_NPV",
            "expression": "MIN([npv_eur])"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "rel_scenario_simulation",
        "fromTable": "TCO_Scenarios",
        "fromColumn": "scenario_id",
        "toTable": "Simulation_Runs",
        "toColumn": "scenario_id",
        "crossFilteringBehavior": "bothDirections"
      }
    ]
  }
}
